########################################
# Service port                         #
########################################
#
# Most of these can be kept as is.
# You probably only need to change this if you run multiple
# services simultaneously on your local dev machine.
#

HTTP_PORT=8080

########################################
# Logging                              #
########################################

LOG_LEVEL=info

########################################
# Downstream service connections       #
########################################
#
# Host and gRPC port for each backend service.
# When running against the dev Docker stack, set these to the
# dev server IP and the exposed gRPC ports.
#

AUTHSERVICE_HOST=localhost
AUTHSERVICE_PORT=8081

ROUTERSERVICE_HOST=localhost
ROUTERSERVICE_PORT=8081

SEARCHSERVICE_HOST=localhost
SEARCHSERVICE_PORT=8081

REGIONSERVICE_HOST=localhost
REGIONSERVICE_PORT=8081

# tilesservice exposes HTTP only (no gRPC)
TILESSERVICE_HOST=localhost
TILESSERVICE_PORT=8080

########################################
# Redis                                #
########################################
#
# Used for rate limiting (sliding window) and the async job queue (Plan 04).
#

REDIS_HOST=localhost
REDIS_PORT=6379

########################################
# Service client credentials           #
########################################
#
# Obtained by registering swayrider-api as a service client in authservice.
# See README.md for the registration command.
#

SWAYRIDER_API_CLIENT_ID=
SWAYRIDER_API_CLIENT_SECRET=

########################################
# Async job queue tuning               #
########################################
#
# Workers pull jobs from Redis Streams and call the downstream gRPC services.
# Increase counts to raise throughput; raise QUEUE_MAX_DEPTH to allow more
# backlog before the gateway starts returning 429 to new requests.
#

# Number of goroutines draining the routing stream
ROUTE_WORKER_COUNT=5

# Number of goroutines draining the search stream
SEARCH_WORKER_COUNT=10

# Maximum number of pending messages across routing/search streams combined
QUEUE_MAX_DEPTH=500

# How long (seconds) to keep completed job results in Redis
RESULT_TTL_SECONDS=300

########################################
# Rate limits (requests per minute)    #
########################################

# Login, register, password-reset, verify-email endpoints (per IP)
RATE_LIMIT_IP_AUTH=10

# Tiles, health, public-keys (per IP)
RATE_LIMIT_IP_PUBLIC=600

# Unauthenticated requests to per-user endpoints, e.g. refresh, logout,
# reset-password, check-password-strength, or floods at protected endpoints (per IP)
RATE_LIMIT_IP_API=60

# General authenticated endpoints (per user)
RATE_LIMIT_USER_API=300

# Route and search endpoints (per user)
RATE_LIMIT_USER_EXPENSIVE=20

########################################
# CORS                                 #
########################################
#
# Comma-separated list of allowed origins.
# AllowCredentials is always enabled, so wildcard (*) is not supported.
#

CORS_ALLOWED_ORIGINS=http://localhost:5173

########################################
# Trusted proxies                      #
########################################
#
# Comma-separated list of CIDRs whose X-Forwarded-For / X-Forwarded-Proto
# headers are honored for client-IP rate limiting and the cookie Secure flag.
#
# This MUST only contain reverse proxies you control. Requests from any other
# peer are treated as direct connections: X-Forwarded-* is ignored and the
# peer address (RemoteAddr) is used, so a client can never spoof its IP for
# rate limiting or force cookies to be issued without the Secure flag.
#
# Empty (default) = trust no one.
# Dev stack: set to the pinned Traefik container IP (10.10.0.2/32).
#
#TRUSTED_PROXIES=

########################################
# Cookie namespace                     #
########################################
#
# Prefix applied to all cookie names to avoid conflicts with other apps.
# Override only when deploying under a different brand/domain namespace.
#
#COOKIE_NAMESPACE=com.hevanto-it.swayrider
